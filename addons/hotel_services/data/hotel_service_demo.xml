<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="service_breakfast" model="hotel.service">
            <field name="name">Breakfast Buffet</field>
            <field name="price">80000</field>
            <field name="category">fnb</field>
        </record>
        <record id="service_lunch" model="hotel.service">
            <field name="name">Lunch Set</field>
            <field name="price">120000</field>
            <field name="category">fnb</field>
        </record>
        <record id="service_dinner" model="hotel.service">
            <field name="name">Dinner Set</field>
            <field name="price">150000</field>
            <field name="category">fnb</field>
        </record>
        <record id="service_waterfall_tour" model="hotel.service">
            <field name="name">Waterfall Trekking Tour</field>
            <field name="price">350000</field>
            <field name="category">tour</field>
        </record>
        <record id="service_village_tour" model="hotel.service">
            <field name="name">Village Cultural Tour</field>
            <field name="price">250000</field>
            <field name="category">tour</field>
        </record>
        <record id="service_coffee_tour" model="hotel.service">
            <field name="name">Coffee Plantation Tour</field>
            <field name="price">200000</field>
            <field name="category">tour</field>
        </record>
        <record id="service_laundry" model="hotel.service">
            <field name="name">Laundry Service</field>
            <field name="price">50000</field>
            <field name="category">misc</field>
        </record>
        <record id="service_transfer" model="hotel.service">
            <field name="name">Airport Transfer</field>
            <field name="price">500000</field>
            <field name="category">misc</field>
        </record>

        <!-- ── Sample Combo Package ─────────────────────────────────── -->
        <record id="combo_bungalow_adventure" model="hotel.combo">
            <field name="name">Bungalow Adventure Combo (2N)</field>
            <field name="room_type_id" ref="hotel_core.room_type_bungalow"/>
            <field name="nights">2</field>
            <field name="nightly_rate">700000</field>
            <field name="description">2 nights in a Bungalow, daily breakfast for two and the Waterfall Trekking Tour, at a package price.</field>
        </record>
        <record id="combo_line_breakfast" model="hotel.combo.line">
            <field name="combo_id" ref="combo_bungalow_adventure"/>
            <field name="service_id" ref="service_breakfast"/>
            <field name="quantity">4</field>
            <field name="price_unit">70000</field>
        </record>
        <record id="combo_line_waterfall" model="hotel.combo.line">
            <field name="combo_id" ref="combo_bungalow_adventure"/>
            <field name="service_id" ref="service_waterfall_tour"/>
            <field name="quantity">2</field>
            <field name="price_unit">300000</field>
        </record>
    </data>
</odoo>
