<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hoadon30s_einvoice_list" model="ir.ui.view">
        <field name="name">hoadon30s.einvoice.list</field>
        <field name="model">hoadon30s.einvoice</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="date_export"/>
                <field name="serial"/>
                <field name="no"/>
                <field name="init_type"/>
                <field name="partner_id"/>
                <field name="cus_tax_code" optional="show"/>
                <field name="total" sum="Untaxed"/>
                <field name="vat_amount" sum="VAT"/>
                <field name="amount" sum="Total"/>
                <field name="move_id" optional="show"/>
                <field name="pos_order_id" optional="show"/>
                <field name="lookup_code" optional="hide"/>
                <field name="code_cqt" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'coded'"
                       decoration-info="status in ('signed', 'sent')"
                       decoration-danger="status in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_hoadon30s_einvoice_form" model="ir.ui.view">
        <field name="name">hoadon30s.einvoice.form</field>
        <field name="model">hoadon30s.einvoice</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label"/></h1>
                    </div>
                    <group>
                        <group string="Invoice">
                            <field name="init_type"/>
                            <field name="date_export"/>
                            <field name="serial"/>
                            <field name="no"/>
                            <field name="status"/>
                            <field name="code_cqt"/>
                            <field name="lookup_code"/>
                            <field name="id_attr"/>
                        </group>
                        <group string="Buyer &amp; Amounts">
                            <field name="partner_id"/>
                            <field name="cus_name"/>
                            <field name="cus_tax_code"/>
                            <field name="cus_address"/>
                            <field name="currency"/>
                            <field name="total"/>
                            <field name="vat_amount"/>
                            <field name="amount"/>
                            <field name="move_id"/>
                            <field name="pos_order_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hoadon30s_einvoice_search" model="ir.ui.view">
        <field name="name">hoadon30s.einvoice.search</field>
        <field name="model">hoadon30s.einvoice</field>
        <field name="arch" type="xml">
            <search>
                <field name="no"/>
                <field name="lookup_code"/>
                <field name="partner_id"/>
                <field name="cus_name"/>
                <field name="cus_tax_code"/>
                <filter string="VAT Invoices" name="hdgtgt"
                        domain="[('init_type', '=', 'HDGTGT')]"/>
                <filter string="Cash Register" name="hdgtgtmtt"
                        domain="[('init_type', '=', 'HDGTGTMTT')]"/>
                <separator/>
                <filter string="Tax Code Granted" name="coded"
                        domain="[('status', '=', 'coded')]"/>
                <filter string="Not Linked in Odoo" name="unlinked"
                        domain="[('move_id', '=', False), ('pos_order_id', '=', False)]"/>
                <group>
                    <filter string="Buyer" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Issue Date" name="group_date"
                            context="{'group_by': 'date_export'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hoadon30s_einvoice" model="ir.actions.act_window">
        <field name="name">VN E-Invoices</field>
        <field name="res_model">hoadon30s.einvoice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No e-invoices synced yet</p>
            <p>Use "Fetch E-Invoices" to pull the VAT e-invoices issued at
               hoadon30s.vn. Buyers are matched to partners by tax code and
               created automatically when unknown.</p>
        </field>
    </record>

    <menuitem id="menu_hoadon30s_root" name="VN E-Invoice"
              parent="account.menu_finance" sequence="19"/>
    <menuitem id="menu_hoadon30s_einvoice" name="E-Invoices"
              parent="menu_hoadon30s_root" sequence="10"
              action="action_hoadon30s_einvoice"/>
</odoo>
