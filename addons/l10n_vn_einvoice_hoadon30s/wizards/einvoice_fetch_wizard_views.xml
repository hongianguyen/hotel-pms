<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_einvoice_fetch_wizard_form" model="ir.ui.view">
        <field name="name">hoadon30s.einvoice.fetch.wizard.form</field>
        <field name="model">hoadon30s.einvoice.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Fetch E-Invoices">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_fetch" type="object"
                            string="Fetch" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_einvoice_fetch_wizard" model="ir.actions.act_window">
        <field name="name">Fetch E-Invoices</field>
        <field name="res_model">hoadon30s.einvoice.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hoadon30s_fetch" name="Fetch E-Invoices"
              parent="menu_hoadon30s_root" sequence="20"
              action="action_einvoice_fetch_wizard"/>
</odoo>
