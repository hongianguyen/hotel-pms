<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aiosell_sync_log_list" model="ir.ui.view">
        <field name="name">aiosell.sync.log.list</field>
        <field name="model">aiosell.sync.log</field>
        <field name="arch" type="xml">
            <list string="Aiosell Sync Log" decoration-danger="state == 'error'"
                  decoration-warning="state == 'refused'"
                  decoration-muted="state == 'pending'" create="false">
                <field name="create_date" string="When"/>
                <field name="config_id"/>
                <field name="direction"/>
                <field name="operation"/>
                <field name="booking_id" optional="show"/>
                <field name="reservation_id" optional="show"/>
                <field name="http_status" optional="hide"/>
                <field name="state"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_aiosell_sync_log_form" model="ir.ui.view">
        <field name="name">aiosell.sync.log.form</field>
        <field name="model">aiosell.sync.log</field>
        <field name="arch" type="xml">
            <form string="Aiosell Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="direction"/>
                            <field name="operation"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="endpoint"/>
                            <field name="http_status"/>
                            <field name="booking_id"/>
                            <field name="reservation_id"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <notebook>
                        <page string="Request">
                            <field name="request_body" widget="text"/>
                        </page>
                        <page string="Response">
                            <field name="response_body" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aiosell_sync_log_search" model="ir.ui.view">
        <field name="name">aiosell.sync.log.search</field>
        <field name="model">aiosell.sync.log</field>
        <field name="arch" type="xml">
            <search string="Aiosell Sync Log">
                <field name="operation"/>
                <field name="booking_id"/>
                <field name="reservation_id"/>
                <filter name="errors" string="Errors"
                        domain="[('state', '=', 'error')]"/>
                <filter name="refused" string="Needs Attention"
                        domain="[('state', '=', 'refused')]"/>
                <filter name="inbound" string="Inbound"
                        domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound"
                        domain="[('direction', '=', 'outbound')]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_operation" string="Operation"
                            context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aiosell_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Log</field>
        <field name="res_model">aiosell.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>
</odoo>
