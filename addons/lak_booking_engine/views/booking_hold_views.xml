<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lak_booking_hold_list" model="ir.ui.view">
        <field name="name">lak.booking.hold.list</field>
        <field name="model">lak.booking.hold</field>
        <field name="arch" type="xml">
            <list create="false" delete="false"
                  decoration-warning="expiring_soon"
                  decoration-muted="state in ('expired', 'cancelled')"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="room_type_id"/>
                <field name="room_count"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expires_at"/>
                <field name="expiring_soon" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_lak_booking_hold_form" model="ir.ui.view">
        <field name="name">lak.booking.hold.form</field>
        <field name="model">lak.booking.hold</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_confirm_payment" type="object"
                            string="Confirm Payment" class="btn-primary"
                            invisible="state != 'pending'"
                            confirm="Have you seen this exact amount arrive in the MB account with this reference in the transfer note?"/>
                    <button name="action_cancel" type="object" string="Cancel Booking"
                            invisible="state != 'pending'"
                            confirm="Release the rooms of this booking?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-bed" string="Reservations"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Guest">
                            <field name="guest_id"/>
                            <field name="guest_name"/>
                            <field name="guest_email" widget="email"/>
                            <field name="guest_phone" widget="phone"/>
                        </group>
                        <group string="Stay">
                            <field name="room_type_id"/>
                            <field name="room_count"/>
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_method"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="expires_at"/>
                            <field name="confirmed_at" invisible="not confirmed_at"/>
                            <field name="confirmed_by" invisible="not confirmed_by"/>
                        </group>
                        <group string="Other">
                            <field name="client_ip"/>
                            <field name="create_date" string="Booked At"/>
                        </group>
                    </group>
                    <field name="note" placeholder="No note from the guest."/>
                    <field name="reservation_ids">
                        <list>
                            <field name="reservation_number"/>
                            <field name="room_id"/>
                            <field name="adults"/>
                            <field name="children"/>
                            <field name="total_amount"/>
                            <field name="folio_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lak_booking_hold_search" model="ir.ui.view">
        <field name="name">lak.booking.hold.search</field>
        <field name="model">lak.booking.hold</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="guest_name"/>
                <field name="guest_email"/>
                <filter name="pending" string="Awaiting Payment" domain="[('state', '=', 'pending')]"/>
                <filter name="expiring_soon" string="Expiring Soon (4 h)" domain="[('expiring_soon', '=', True)]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lak_booking_hold" model="ir.actions.act_window">
        <field name="name">Website Bookings</field>
        <field name="res_model">lak.booking.hold</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No website bookings yet.</p>
            <p>Bookings made on the camp website appear here while they wait
                for the guest's bank transfer.</p>
        </field>
    </record>

    <menuitem id="menu_lak_booking_hold"
              name="Website Bookings"
              parent="hotel_frontdesk.menu_hotel_frontdesk"
              action="action_lak_booking_hold"
              sequence="15"/>
</odoo>
