<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gdt_connect_wizard_form" model="ir.ui.view">
        <field name="name">hoadon30s.gdt.connect.wizard.form</field>
        <field name="model">hoadon30s.gdt.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect Tax Portal">
                <div class="alert alert-info" role="alert">
                    Enter the company's login for
                    <b>hoadondientu.gdt.gov.vn</b>. It is sent to hoadon30s.vn
                    to link the account and is not stored in Odoo. Connect
                    again whenever that password changes.
                </div>
                <group>
                    <field name="username"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_connect" type="object" string="Connect"
                            class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
