<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_einvoice_list" model="ir.ui.view">
        <field name="name">hoadon30s.purchase.einvoice.list</field>
        <field name="model">hoadon30s.purchase.einvoice</field>
        <field name="arch" type="xml">
            <list string="Input VAT Invoices" create="false"
                  decoration-muted="state == 'ignored'"
                  decoration-danger="state in ('no_xml', 'parse_error')"
                  decoration-success="state == 'billed'">
                <field name="invoice_date"/>
                <field name="serial"/>
                <field name="number"/>
                <field name="seller_name"/>
                <field name="seller_tax_code" optional="show"/>
                <field name="is_mtt" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_untaxed" sum="Untaxed" optional="show"/>
                <field name="amount_tax" sum="VAT" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="move_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'billed'"
                       decoration-danger="state in ('no_xml', 'parse_error')"
                       decoration-muted="state == 'ignored'"/>
                <button name="action_create_bill" type="object"
                        string="Create Bill" icon="fa-file-text-o"
                        invisible="state != 'downloaded'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_einvoice_form" model="ir.ui.view">
        <field name="name">hoadon30s.purchase.einvoice.form</field>
        <field name="model">hoadon30s.purchase.einvoice</field>
        <field name="arch" type="xml">
            <form string="Input VAT Invoice" create="false">
                <header>
                    <button name="action_create_bill" type="object"
                            string="Create Vendor Bill" class="btn-primary"
                            invisible="state != 'downloaded'"/>
                    <button name="action_ignore" type="object" string="Ignore"
                            invisible="state in ('billed', 'ignored')"/>
                    <button name="action_reset_to_downloaded" type="object"
                            string="Reset" invisible="state != 'ignored'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="downloaded,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_xml" type="object"
                                class="oe_stat_button" icon="fa-file-code-o"
                                invisible="not xml_file">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                                <span class="o_stat_text">XML</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Billed" bg_color="text-bg-success"
                            invisible="state != 'billed'"/>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Invoice">
                            <field name="invoice_date"/>
                            <field name="form_no"/>
                            <field name="serial"/>
                            <field name="number"/>
                            <field name="is_mtt"/>
                            <field name="code_cqt"/>
                        </group>
                        <group string="Seller">
                            <field name="seller_name"/>
                            <field name="seller_tax_code"/>
                            <field name="seller_address"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_name"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                        </group>
                        <group string="Accounting">
                            <field name="move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Files" name="files">
                            <group>
                                <field name="xml_filename" invisible="1"/>
                                <field name="xml_file" filename="xml_filename"/>
                                <field name="pdf_filename" invisible="1"/>
                                <field name="pdf_file" filename="pdf_filename"/>
                            </group>
                        </page>
                        <page string="Parsed Content" name="parsed"
                              groups="base.group_no_one">
                            <field name="parsed_json" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                        <page string="Provider Data" name="raw"
                              groups="base.group_no_one">
                            <field name="raw_json" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_einvoice_search" model="ir.ui.view">
        <field name="name">hoadon30s.purchase.einvoice.search</field>
        <field name="model">hoadon30s.purchase.einvoice</field>
        <field name="arch" type="xml">
            <search string="Input VAT Invoices">
                <field name="number"/>
                <field name="serial"/>
                <field name="seller_name"/>
                <field name="seller_tax_code"/>
                <field name="partner_id"/>
                <filter name="filter_not_billed" string="Not Billed"
                        domain="[('state', '=', 'downloaded')]"/>
                <filter name="filter_billed" string="Billed"
                        domain="[('state', '=', 'billed')]"/>
                <filter name="filter_problem" string="Needs Attention"
                        domain="[('state', 'in', ('no_xml', 'parse_error'))]"/>
                <separator/>
                <filter name="filter_mtt" string="Cash Register"
                        domain="[('is_mtt', '=', True)]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('invoice_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Issue Date"
                            context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_einvoice" model="ir.actions.act_window">
        <field name="name">Input VAT Invoices</field>
        <field name="res_model">hoadon30s.purchase.einvoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_einvoice_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No input invoices downloaded yet
            </p>
            <p>
                Use <b>Download Input Invoices</b> to pull the VAT invoices
                your vendors issued to the company from the tax portal.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_einvoice"
              name="Input VAT Invoices"
              parent="account.menu_finance_payables"
              action="action_purchase_einvoice"
              sequence="94"/>
</odoo>
