<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_housekeeping_task_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.list</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="status in ('done', 'cancelled')">
                <field name="priority" widget="priority"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_to" optional="show"/>
                <field name="create_date" string="Created"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="completed_at" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'todo'"
                       decoration-warning="status == 'in_progress'"
                       decoration-success="status == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_housekeeping_task_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.kanban</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong><field name="room_id"/></strong>
                                <div class="text-muted small"><field name="name"/></div>
                                <div class="small">SLA: <field name="deadline"/></div>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="mt-2 d-flex gap-1">
                            <button name="action_start" type="object"
                                    class="btn btn-sm btn-info"
                                    invisible="status != 'todo'">▶ Start</button>
                            <button name="action_done" type="object"
                                    class="btn btn-sm btn-success"
                                    invisible="status not in ('todo', 'in_progress')">✓ Done</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="status != 'todo'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-success" invisible="status not in ('todo', 'in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status in ('done', 'cancelled')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id"/>
                            <field name="reservation_id" readonly="1"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="sla_minutes"/>
                            <field name="deadline"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Cleaning Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cleaning tasks</p>
            <p>Tasks are created automatically at guest checkout.</p>
        </field>
    </record>

    <record id="view_hotel_housekeeping_task_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_id"/>
                <field name="assigned_to"/>
                <filter string="Open" name="open" domain="[('status', 'in', ['todo', 'in_progress'])]"/>
                <filter string="High Priority" name="high" domain="[('priority', '=', '1')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Assignee" name="group_assignee" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
