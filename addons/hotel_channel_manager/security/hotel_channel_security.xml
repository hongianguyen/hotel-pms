<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Record rules: Channel Manager records scoped to company -->
    <record id="channel_config_company_rule" model="ir.rule">
        <field name="name">Channel Config: Company</field>
        <field name="model_id" ref="model_channel_manager_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
