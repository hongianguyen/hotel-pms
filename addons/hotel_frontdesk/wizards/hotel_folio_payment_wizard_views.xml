<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         FOLIO PAYMENT WIZARD
         ════════════════════════════════════════════════════════════════ -->

    <record id="view_hotel_folio_payment_wizard_form" model="ir.ui.view">
        <field name="name">hotel.folio.payment.wizard.form</field>
        <field name="model">hotel.folio.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <group>
                        <field name="folio_id" readonly="1"/>
                        <field name="partner_id" required="1"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="balance" widget="monetary" readonly="1"/>
                        <field name="amount" widget="monetary"/>
                        <field name="journal_id"/>
                        <field name="communication"/>
                    </group>
                </group>
                <footer>
                    <button name="action_register_payment" type="object"
                            string="Register Payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_folio_payment_wizard" model="ir.actions.act_window">
        <field name="name">Register Payment</field>
        <field name="res_model">hotel.folio.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
