<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         RESERVATION VIEWS
         ════════════════════════════════════════════════════════════════ -->

    <!-- Reservation List -->
    <record id="view_hotel_reservation_list" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'no_show'"
                  decoration-success="state == 'checked_in'"
                  decoration-info="state == 'confirmed'">
                <field name="reservation_number"/>
                <field name="guest_id"/>
                <field name="group_id" optional="show"/>
                <field name="room_id"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="nights"/>
                <field name="pax_names" optional="show" string="Guests"/>
                <field name="total_amount" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-primary="state == 'confirmed'"
                       decoration-success="state == 'checked_in'"
                       decoration-muted="state == 'checked_out'"
                       decoration-danger="state in ('cancelled', 'no_show')"/>
            </list>
        </field>
    </record>

    <!-- Reservation Form -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object"
                            string="Check In" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_check_out" type="object"
                            string="Check Out" class="btn-primary"
                            invisible="state != 'checked_in'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state in ('checked_out', 'cancelled')"
                            confirm="Are you sure you want to cancel this reservation?"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="state not in ('cancelled', 'no_show')"/>
                    <button name="action_send_confirmation_email" type="object"
                            string="✉ Send Confirmation" class="btn-secondary"
                            invisible="state not in ('confirmed', 'checked_in')"/>
                    <button name="action_edit_confirmation_template" type="object"
                            string="Edit Template" class="btn-secondary"
                            groups="hotel_core.group_hotel_admin"
                            invisible="state not in ('confirmed', 'checked_in')"/>
                    <!-- Exit: unsaved record → discard/close; saved record →
                         navigate back to the dashboard (discard alone would
                         silently do nothing after e.g. Confirm). -->
                    <button string="Exit" special="cancel"
                            class="btn-secondary" data-hotkey="x"
                            invisible="id"/>
                    <button string="Exit" type="object" name="action_exit"
                            class="btn-secondary" data-hotkey="x"
                            invisible="not id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reservation_number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Information">
                            <field name="guest_id"/>
                            <field name="guest_phone"/>
                            <field name="guest_email"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                        <group string="Room &amp; Dates">
                            <field name="is_roh" invisible="1"/>
                            <field name="allowed_room_type_ids" invisible="1"/>
                            <field name="room_type_id"
                                   domain="[('is_roh', '=', False)]"/>
                            <field name="room_id"/>
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="nights"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pricing">
                            <field name="combo_id"/>
                            <field name="rate_plan_id" invisible="combo_id"/>
                            <field name="payment_required"/>
                            <field name="prepaid" invisible="not payment_required"/>
                            <field name="nightly_rate" widget="monetary"/>
                            <field name="services_total" widget="monetary"
                                   invisible="not service_line_ids"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                        <group string="Booking Details">
                            <field name="source_id"/>
                            <field name="send_confirmation"/>
                            <field name="folio_id" readonly="1"/>
                            <field name="group_id" readonly="1" invisible="not group_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="services">
                            <field name="service_line_ids"
                                   readonly="state in ('checked_out', 'cancelled')">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="combo_id" force_save="1" optional="show"/>
                                    <field name="date" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="note" optional="show"/>
                                    <field name="is_charged" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Guests (Pax)" name="pax">
                            <field name="pax_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Full guest name..."/>
                                    <field name="pax_type"/>
                                    <field name="id_number" optional="show"/>
                                    <field name="nationality_id" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Special requests, notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Reservation Calendar -->
    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar date_start="checkin_date" date_stop="checkout_date"
                      color="state" mode="month"
                      event_open_popup="true" quick_create="0">
                <field name="reservation_number"/>
                <field name="guest_id"/>
                <field name="room_id"/>
            </calendar>
        </field>
    </record>

    <!-- Reservation Search -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="reservation_number"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="group_id"/>
                <separator/>
                <filter string="Group Bookings" name="in_group" domain="[('group_id', '!=', False)]"/>
                <separator/>
                <filter string="Today Arrivals" name="today_arrivals"
                        domain="[('checkin_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Today Departures" name="today_departures"
                        domain="[('checkout_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Checked Out" name="checked_out" domain="[('state', '=', 'checked_out')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="No Show" name="no_show" domain="[('state', '=', 'no_show')]"/>
                <separator/>
                <group>
                    <filter string="Guest" name="group_guest" context="{'group_by': 'guest_id'}"/>
                    <filter string="Group Booking" name="group_booking" context="{'group_by': 'group_id'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Check-in Date" name="group_checkin" context="{'group_by': 'checkin_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Reservation Action -->
    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_hotel_reservation_search"/>
        <field name="context">{'search_default_today_arrivals': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first reservation
            </p>
            <p>Manage guest bookings, check-ins, and check-outs.</p>
        </field>
    </record>
</odoo>
