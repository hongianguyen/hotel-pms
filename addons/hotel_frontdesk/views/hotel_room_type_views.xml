<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_type_form_occupancy" model="ir.ui.view">
        <field name="name">hotel.room.type.form.occupancy</field>
        <field name="model">hotel.room.type</field>
        <field name="inherit_id" ref="hotel_core.view_hotel_room_type_form"/>
        <field name="arch" type="xml">
            <field name="capacity" position="after">
                <field name="max_adults"/>
                <field name="max_children"/>
                <div colspan="2" class="text-muted small">
                    Max Children counts children 6-12 and infants 0-6 together.
                    Adults + children + infants must not exceed Max Occupancy.
                </div>
            </field>
        </field>
    </record>

    <record id="view_hotel_room_type_list_occupancy" model="ir.ui.view">
        <field name="name">hotel.room.type.list.occupancy</field>
        <field name="model">hotel.room.type</field>
        <field name="inherit_id" ref="hotel_core.view_hotel_room_type_list"/>
        <field name="arch" type="xml">
            <field name="capacity" position="after">
                <field name="max_adults"/>
                <field name="max_children"/>
            </field>
        </field>
    </record>
</odoo>
