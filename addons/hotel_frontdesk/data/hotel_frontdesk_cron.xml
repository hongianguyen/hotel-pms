<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- No-show sweep: hourly (spec 6.1) -->
        <record id="ir_cron_hotel_no_show" model="ir.cron">
            <field name="name">Hotel: Mark No-Show Reservations</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_no_shows()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- Pre-arrival reminder: daily 09:00 (spec 6.3) -->
        <record id="ir_cron_hotel_prearrival" model="ir.cron">
            <field name="name">Hotel: Pre-Arrival Reminder Emails</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_prearrival_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- Pre-arrival email template -->
        <record id="mail_template_prearrival_reminder" model="mail.template">
            <field name="name">Hotel: Pre-Arrival Reminder</field>
            <field name="model_id" ref="hotel_frontdesk.model_hotel_reservation"/>
            <field name="subject">See you tomorrow! Reservation {{ object.reservation_number }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <!-- use_default_to must be off: it would ignore email_to and look
                 for a partner_id/email field, which our model does not have -->
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object.guest_id.email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.guest_id.name"/>,</p>
    <p>We are looking forward to welcoming you tomorrow!</p>
    <table style="border-collapse: collapse;">
        <tr><td style="padding: 6px 12px 6px 0;"><strong>Reservation</strong></td>
            <td><t t-out="object.reservation_number"/></td></tr>
        <tr><td style="padding: 6px 12px 6px 0;"><strong>Room</strong></td>
            <td><t t-out="object.room_id.display_name"/></td></tr>
        <tr><td style="padding: 6px 12px 6px 0;"><strong>Check-in</strong></td>
            <td><t t-out="object.checkin_date"/></td></tr>
        <tr><td style="padding: 6px 12px 6px 0;"><strong>Check-out</strong></td>
            <td><t t-out="object.checkout_date"/></td></tr>
    </table>
    <p>Safe travels,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
